{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.dev)",
      "Edit(**/.env.dev)",
      "Read(**/.env.prod)",
      "Edit(**/.env.prod)",
      "Read(**/token.json)",
      "Edit(**/token.json)",
      "Edit(legacy/**)",
      "Write(legacy/**)"
    ]
  }
}
